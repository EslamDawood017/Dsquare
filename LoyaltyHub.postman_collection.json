		{
			"name": "2. Awards - Success & Idempotency",
			"item": [
				{
					"name": "Award Points - First Time (201 Created)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"AwardId is generated\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.awardId).to.be.a(\"string\");",
									"    pm.expect(jsonData.points).to.eql(50);",
									"    pm.environment.set(\"lastAwardId\", jsonData.awardId);",
									"});",
									"pm.test(\"Location header is present\", function () {",
									"    pm.response.to.have.header(\"Location\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sourceId\": \"partner_pos_01\",\n  \"externalTransactionId\": \"tx_20261107_001\",\n  \"walletId\": \"W100\",\n  \"points\": 50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/awards",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"awards"
							]
						},
						"description": "First time an award is submitted. Successfully awards 50 points to W100 and returns 201 Created."
					},
					"response": []
				},
				{
					"name": "Award Points - Idempotent Retry (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200 OK on retry\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Returns the same original AwardId\", function () {",
									"    var jsonData = pm.response.json();",
									"    var savedAwardId = pm.environment.get(\"lastAwardId\");",
									"    if (savedAwardId) {",
									"        pm.expect(jsonData.awardId).to.eql(savedAwardId);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sourceId\": \"partner_pos_01\",\n  \"externalTransactionId\": \"tx_20261107_001\",\n  \"walletId\": \"W100\",\n  \"points\": 50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/awards",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"awards"
							]
						},
						"description": "Network retry with exact same (sourceId, externalTransactionId, walletId, points). Returns 200 OK with the original award without duplicate point credit."
					},
					"response": []
				},
				{
					"name": "Verify Balance After Award (200 OK - Balance 150)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Balance is exactly 150 (not duplicated)\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.balance).to.eql(150);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/wallets/W100",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"wallets",
								"W100"
							]
						},
						"description": "Verifies that W100 received points once (100 + 50 = 150), and the retry did not add duplicate points."
					},
					"response": []
				}
			]
		},
