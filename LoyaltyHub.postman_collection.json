									"});",
									"pm.test(\"WalletId is W100 and has balance\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.walletId).to.eql(\"W100\");",
									"    pm.expect(jsonData.balance).to.be.a(\"number\");",
